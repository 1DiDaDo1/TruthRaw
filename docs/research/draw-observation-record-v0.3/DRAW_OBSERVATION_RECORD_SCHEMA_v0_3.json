{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "D.RAW/DRAWObservationRecord/0.3",
  "title": "D.RAW Observation Record v0.3 — explicit knowledge placement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_id",
    "source_evidence",
    "procedure",
    "source_topology",
    "capability_envelope",
    "gauge",
    "precision",
    "scientific_master",
    "authority_field",
    "legacy_truthnegative_parent",
    "drawnegative",
    "evidence_counts",
    "authority_axes",
    "invariants",
    "parent_record_schema",
    "graph_node",
    "knowledge_placement",
    "authority_dimensions",
    "temporal_footprint",
    "optical_support",
    "calibration_bindings",
    "knowledge_growth_invariants"
  ],
  "properties": {
    "schema": {
      "const": "D.RAW/DRAWObservationRecord/0.3"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "sealed"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sealed": {
          "const": true
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "lens_role"
      ],
      "properties": {
        "lens_role": {
          "enum": [
            "MAIN",
            "ULTRA_WIDE",
            "TELEPHOTO",
            "FRONT",
            "EXTERNAL",
            "UNKNOWN"
          ]
        }
      }
    },
    "source_topology": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capability_envelope": {
      "type": "object"
    },
    "gauge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truthrange_formula",
        "scale_gauge_id",
        "gauge_relation",
        "shared_free_world_gauge_id",
        "cross_observation_radiometric_equality_allowed",
        "cross_observation_radiometric_fusion_allowed"
      ],
      "properties": {
        "truthrange_formula": {
          "const": "T=log2(L/L0)"
        },
        "scale_gauge_id": {
          "type": "string",
          "minLength": 1
        },
        "gauge_relation": {
          "enum": [
            "SOURCE_LOCAL_ONLY",
            "SHARED_RELATIVE",
            "SHARED_ABSOLUTE"
          ]
        },
        "shared_free_world_gauge_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cross_observation_radiometric_equality_allowed": {
          "type": "boolean"
        },
        "cross_observation_radiometric_fusion_allowed": {
          "type": "boolean"
        }
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_sensitive_compute",
        "canonical_storage",
        "precision_upgrades_authority"
      ],
      "properties": {
        "branch_sensitive_compute": {
          "const": "FLOAT64"
        },
        "canonical_storage": {
          "enum": [
            "FLOAT32_VALIDATED",
            "FLOAT64"
          ]
        },
        "precision_upgrades_authority": {
          "const": false
        }
      }
    },
    "scientific_master": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "authority_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "legacy_truthnegative_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_sha256",
        "schema_role",
        "raster_independent"
      ],
      "properties": {
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_role": {
          "const": "LEGACY_VALIDATED_COMPUTATIONAL_PARENT"
        },
        "raster_independent": {
          "const": true
        }
      }
    },
    "drawnegative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state_sha256",
        "parent_truthnegative_state_sha256",
        "observation_id",
        "per_observation_lineage",
        "raster_independent",
        "truthrange_coordinate_family_declared",
        "per_sample_truthrange_materialized",
        "creates_new_evidence",
        "scientific_writeback_allowed"
      ],
      "properties": {
        "schema": {
          "const": "D.RAW/D.RAWnegative/0.1"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_truthnegative_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "per_observation_lineage": {
          "const": true
        },
        "raster_independent": {
          "const": true
        },
        "truthrange_coordinate_family_declared": {
          "const": true
        },
        "per_sample_truthrange_materialized": {
          "type": "boolean"
        },
        "creates_new_evidence": {
          "const": false
        },
        "scientific_writeback_allowed": {
          "const": false
        }
      }
    },
    "evidence_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_frame_count",
        "independent_evidence_count"
      ],
      "properties": {
        "physical_frame_count": {
          "const": 1
        },
        "independent_evidence_count": {
          "const": 1
        }
      }
    },
    "authority_axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_authority",
        "radiometric_authority",
        "axes_are_separate"
      ],
      "properties": {
        "geometry_authority": {
          "type": "string",
          "minLength": 1
        },
        "radiometric_authority": {
          "type": "string",
          "minLength": 1
        },
        "axes_are_separate": {
          "const": true
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lens_identity_upgrades_authority",
        "file_format_upgrades_authority",
        "appearance_writeback_allowed"
      ],
      "properties": {
        "lens_identity_upgrades_authority": {
          "const": false
        },
        "file_format_upgrades_authority": {
          "const": false
        },
        "appearance_writeback_allowed": {
          "const": false
        }
      }
    },
    "parent_record_schema": {
      "const": "D.RAW/DRAWObservationRecord/0.2"
    },
    "graph_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state_sha256",
        "temporal_model",
        "creates_new_evidence",
        "scientific_writeback_allowed"
      ],
      "properties": {
        "schema": {
          "const": "D.RAW/FreeWorldObservationGraphNative/0.1"
        },
        "state_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "temporal_model": {
          "enum": [
            "UNKNOWN",
            "CAPTURE_TIMESTAMP_ONLY",
            "EXPOSURE_INTERVAL",
            "GLOBAL_SHUTTER_INTERVAL",
            "ROLLING_SHUTTER_MODEL"
          ]
        },
        "creates_new_evidence": {
          "const": false
        },
        "scientific_writeback_allowed": {
          "const": false
        }
      }
    },
    "knowledge_placement": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "floor",
          "authority",
          "identity_sha256",
          "creates_new_evidence"
        ],
        "properties": {
          "domain": {
            "enum": [
              "SOURCE_EVIDENCE",
              "SAMPLING_GEOMETRY",
              "GEOMETRY_POSE",
              "RADIOMETRY",
              "COLORIMETRY",
              "SPECTRAL",
              "OPTICAL_SUPPORT",
              "NOISE_UNCERTAINTY",
              "TEMPORAL",
              "PROVENANCE",
              "MATERIAL",
              "ILLUMINATION",
              "RESTORATION",
              "APPEARANCE"
            ]
          },
          "floor": {
            "enum": [
              "EVIDENCE",
              "SCIENTIFIC_DERIVED",
              "SCENE_MODEL",
              "APPEARANCE"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "identity_sha256": {
            "$ref": "#/$defs/nullableSha256"
          },
          "creates_new_evidence": {
            "const": false
          }
        }
      }
    },
    "authority_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampling_geometry",
        "geometry_pose",
        "radiometry",
        "colorimetry",
        "spectral",
        "optical_support",
        "noise_uncertainty",
        "temporal",
        "provenance"
      ],
      "properties": {
        "sampling_geometry": {
          "$ref": "#/$defs/authorityDimension"
        },
        "geometry_pose": {
          "$ref": "#/$defs/authorityDimension"
        },
        "radiometry": {
          "$ref": "#/$defs/authorityDimension"
        },
        "colorimetry": {
          "$ref": "#/$defs/authorityDimension"
        },
        "spectral": {
          "$ref": "#/$defs/authorityDimension"
        },
        "optical_support": {
          "$ref": "#/$defs/authorityDimension"
        },
        "noise_uncertainty": {
          "$ref": "#/$defs/authorityDimension"
        },
        "temporal": {
          "$ref": "#/$defs/authorityDimension"
        },
        "provenance": {
          "$ref": "#/$defs/authorityDimension"
        }
      }
    },
    "temporal_footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "capture_timestamp_identity_sha256",
        "exposure_interval_known",
        "rolling_shutter_model_known"
      ],
      "properties": {
        "model": {
          "enum": [
            "UNKNOWN",
            "CAPTURE_TIMESTAMP_ONLY",
            "EXPOSURE_INTERVAL",
            "GLOBAL_SHUTTER_INTERVAL",
            "ROLLING_SHUTTER_MODEL"
          ]
        },
        "capture_timestamp_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "exposure_interval_known": {
          "type": "boolean"
        },
        "rolling_shutter_model_known": {
          "type": "boolean"
        },
        "exposure_start_ns": {
          "type": "integer"
        },
        "exposure_end_ns": {
          "type": "integer"
        },
        "row_readout_time_ns": {
          "type": "integer"
        }
      }
    },
    "optical_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "model_kind",
        "support_identity_sha256",
        "field_dependent",
        "spatial_frequency_dependent",
        "focus_dependent",
        "spectral_or_channel_dependent",
        "numeric_scene_value_changed",
        "authority_upgraded"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "model_kind": {
          "enum": [
            "NONE",
            "PSF",
            "OTF",
            "MTF",
            "SFR",
            "COMPOSITE"
          ]
        },
        "support_identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "field_dependent": {
          "type": "boolean"
        },
        "spatial_frequency_dependent": {
          "type": "boolean"
        },
        "focus_dependent": {
          "type": "boolean"
        },
        "spectral_or_channel_dependent": {
          "type": "boolean"
        },
        "numeric_scene_value_changed": {
          "const": false
        },
        "authority_upgraded": {
          "const": false
        }
      }
    },
    "calibration_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "calibration_record_sha256",
          "validity_domain_sha256",
          "holdout_report_sha256",
          "applicable",
          "admitted"
        ],
        "properties": {
          "kind": {
            "enum": [
              "BLACK_OFFSET",
              "LINEARITY",
              "GAIN_NOISE",
              "PRNU",
              "LENS_SHADING",
              "OPTICS_PSF_MTF",
              "COLOR",
              "ILLUMINANT",
              "SPECTRAL_RESPONSE"
            ]
          },
          "calibration_record_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "validity_domain_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "holdout_report_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "applicable": {
            "const": true
          },
          "admitted": {
            "const": true
          }
        }
      }
    },
    "knowledge_growth_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_evidence_mutated",
        "drawnegative_v0_1_mutated",
        "relation_promotes_source_evidence",
        "implicit_calibration_transfer_allowed",
        "cross_observation_fusion_granted_by_record",
        "unknown_upgraded_by_appearance"
      ],
      "properties": {
        "source_evidence_mutated": {
          "const": false
        },
        "drawnegative_v0_1_mutated": {
          "const": false
        },
        "relation_promotes_source_evidence": {
          "const": false
        },
        "implicit_calibration_transfer_allowed": {
          "const": false
        },
        "cross_observation_fusion_granted_by_record": {
          "const": false
        },
        "unknown_upgraded_by_appearance": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorityDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "identity_sha256",
        "calibration_binding_sha256",
        "validity_domain_sha256",
        "cross_observation_relation_admitted",
        "implicit_transfer_allowed"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "identity_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "calibration_binding_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "validity_domain_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "cross_observation_relation_admitted": {
          "const": false
        },
        "implicit_transfer_allowed": {
          "const": false
        }
      }
    }
  }
}
