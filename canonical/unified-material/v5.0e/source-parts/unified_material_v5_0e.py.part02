  B=st[0::2,0::2];G1=st[0::2,1::2];G2=st[1::2,0::2];R=st[1::2,1::2];cam=np.stack([R,.5*(G1+G2),B],-1)
  FM,cct,wA=estimate_dual_forward(main,rawpg);neutral=rats(gettag(rawpg,main,50728).value);C2X=FM@np.diag(1/neutral)
  xyz50=np.einsum('ij,...j->...i',C2X,cam);xyz65=np.einsum('ij,...j->...i',ADAPT,xyz50);lin=np.maximum(np.einsum('ij,...j->...i',XYZ65_TO_SRGB,xyz65).astype(np.float32),0)
  npf=np.array(gettag(rawpg,main,51041).value,float);pars={'R':npf[:2],'G1':npf[2:4],'G2':npf[2:4],'B':npf[4:]};snrps=[]
  # crop gain grids in C4 coordinates
  ys=slice(y0//2,(y0+chh)//2);xs=slice(x0//2,(x0+cw)//2)
  for rr,cc,ch in [(0,0,'B'),(0,1,'G1'),(1,0,'G2'),(1,1,'R')]:
   s=stage[rr::2,cc::2][ys,xs];g=gains[ch][ys,xs];a,b=pars[ch];sig=np.maximum(s,0);snrps.append(sig/np.sqrt(np.maximum(g*a*sig+g*g*b,1e-12)))
  snr=np.median(np.stack(snrps,-1),-1).astype(np.float32);sigmas=[]
  for ch in ['R','G1','G2','B']:
