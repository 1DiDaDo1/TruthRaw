def unified_guard(lin,snr,cens,ns):
 detailed,dd=v47j(lin,ns);Y0=dd['Y'];Y1=luma(detailed)
 b08=cv2.GaussianBlur(Y0,(0,0),.8,borderType=cv2.BORDER_REFLECT_101);b25=cv2.GaussianBlur(Y0,(0,0),2.5,borderType=cv2.BORDER_REFLECT_101)
 hf=np.abs(Y0-b08);mf=np.abs(b08-b25);activity=(hf+.60*mf)/np.maximum(b25,.03)
 gx=cv2.Sobel(Y0,cv2.CV_32F,1,0,ksize=3,scale=1/8);gy=cv2.Sobel(Y0,cv2.CV_32F,0,1,ksize=3,scale=1/8)
 jxx=cv2.GaussianBlur(gx*gx,(0,0),1.2);jyy=cv2.GaussianBlur(gy*gy,(0,0),1.2);jxy=cv2.GaussianBlur(gx*gy,(0,0),1.2);tr=jxx+jyy;disc=np.sqrt(np.maximum((jxx-jyy)**2+4*jxy*jxy,0));coh=disc/(tr+1e-9)
 grad=np.sqrt(gx*gx+gy*gy)
 # Generic texture support: no object/material labels, just evidence quality and local texture.
 texture_support=np.clip((activity-.008)/.045,0,1)*np.clip((snr-8)/18,0,1)*(1-.35*np.clip((coh-.92)/.07,0,1))
 # Thin/coherent-risk proxy. It is a limiting cue only, never a classifier.
 thin_risk=np.clip((coh-.62)/.32,0,1)*np.clip((activity-.012)/.045,0,1)*np.clip((snr-5)/12,0,1)
 # Hard-edge risk from canonical backend + local gradient.
 hard_risk=np.maximum(dd['hard'],np.clip((grad/np.maximum(b25,.03)-.09)/.20,0,1))
 # Scene-relative glint/censor risk.
 blur2=cv2.GaussianBlur(Y0,(0,0),2.0,borderType=cv2.BORDER_REFLECT_101);peak=np.maximum(Y0-blur2,0);p97=float(np.percentile(Y0,97));p999=float(np.percentile(Y0,99.9));pk99=float(np.percentile(peak,99))
 rank=np.clip((Y0-p97)/max(p999-p97,1e-6),0,1);glint=np.clip(.65*rank+.35*np.clip(peak/max(pk99,1e-6),0,1),0,1);cnear=cv2.dilate(cens,np.ones((5,5),np.uint8)).astype(np.float32);glint=np.maximum(glint,cnear)
 noise=np.clip((6-snr)/5,0,1)
 # Support can relax texture/edge limiting, but never glint/censoring or low-SNR protection.
 structural=np.maximum(.58*thin_risk,.38*hard_risk)*(1-.48*texture_support)
 safety=np.maximum.reduce([.95*glint,.82*noise,structural])
 safety=cv2.GaussianBlur(safety,(0,0),2.2,borderType=cv2.BORDER_REFLECT_101)
 factor=np.clip(1-.68*safety,.30,1.0)
 guarded=lin+(detailed-lin)*factor[...,None];Yg=luma(guarded)
 # Universal anti-drift constraint: appearance detail cannot alter the broad scene field.
 lf0=cv2.GaussianBlur(Y0,(0,0),4.0,borderType=cv2.BORDER_REFLECT_101);lfg=cv2.GaussianBlur(Yg,(0,0),4.0,borderType=cv2.BORDER_REFLECT_101);Yt=np.maximum(Yg+(lf0-lfg),0)
 lo=cv2.erode(Y0,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);hi=cv2.dilate(Y0,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);rng=np.maximum(hi-lo,1e-5);Yt=np.clip(Yt,lo-.03*rng,hi+.03*rng);Yt=np.maximum(Yt,0)
 # Uniform RGB scalar means no hue/chroma is generated by the material/detail guard.
 sy=np.where(Y0>1e-8,Yt/(Y0+1e-12),1).astype(np.float32);unified=lin*sy[...,None]
 smooth_cue=np.clip(np.exp(-activity*28)*np.exp(-(grad/np.maximum(b25,.03))*8)*np.clip((snr-4)/12,0,1),0,1)
 return detailed,unified,{'Y0':Y0,'Y1':Y1,'Y2':luma(unified),'texture_support':texture_support,'thin_risk':thin_risk,'hard_risk':hard_risk,'glint':glint,'noise':noise,'safety':safety,'smooth_cue':smooth_cue}

def micro95(v,sl):return float(np.percentile(np.abs(v-cv2.GaussianBlur(v,(0,0),.8))[sl],95))
def lfstd(v,sl):return float(np.std(cv2.GaussianBlur(v,(0,0),4.0)[sl]))
def rgbdir(a):return a/np.maximum(np.linalg.norm(a,axis=-1,keepdims=True),1e-9)

def overshoot_p99(neutralY,testY,sl):
 lo=cv2.erode(neutralY,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);hi=cv2.dilate(neutralY,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);rng=np.maximum(hi-lo,1e-6)
 o=np.maximum(np.maximum(testY-hi,lo-testY),0)/rng;return float(np.percentile(o[sl],99))

