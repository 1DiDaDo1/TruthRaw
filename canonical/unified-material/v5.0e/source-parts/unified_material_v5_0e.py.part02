    a=list(v)
    if len(a)==n:return np.array(a,dtype=float)
    if len(a)==2*n:return np.array([a[i]/a[i+1] for i in range(0,2*n,2)],dtype=float)
    raise RuntimeError('unexpected crop tag shape')
   ov=pairvals(org.value,2);sv=pairvals(sz.value,2);x0,y0=int(round(ov[0])),int(round(ov[1]));cw,chh=int(round(sv[0])),int(round(sv[1]))
