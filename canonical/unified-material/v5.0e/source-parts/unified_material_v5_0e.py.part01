def sha256_file(p):
 h=hashlib.sha256()
 with open(p,'rb') as f:
  for c in iter(lambda:f.read(1<<20),b''):h.update(c)
 return h.hexdigest()
def sha256_array(a):
 h=hashlib.sha256();h.update(np.ascontiguousarray(a).view(np.uint8));return h.hexdigest()
def rats(v):
 a=list(v);return np.array([a[i]/a[i+1] for i in range(0,len(a),2)],np.float32)
def mat9(v):return rats(v).reshape(3,3)
def smooth01(x):x=np.clip(x,0,1);return x*x*(3-2*x)
def box(x,r):return cv2.boxFilter(x,cv2.CV_32F,(2*r+1,2*r+1),normalize=True,borderType=cv2.BORDER_REFLECT_101)
def luma(a):return .2126*a[...,0]+.7152*a[...,1]+.0722*a[...,2]
def srgb_enc(x):
 x=np.clip(x,0,None);return np.where(x<=.0031308,12.92*x,1.055*np.power(x,1/2.4)-.055)
def tone(L,wp=1.65):
 L=np.clip(L,0,None);return (L*(1+L/(wp*wp)))/(1+L)
def render(rgb,scale=None):
 rgb=np.maximum(rgb,0).astype(np.float32);Y=luma(rgb)
 if scale is None:scale=.93/max(float(np.percentile(Y,99.5)),1e-6)
 rgb=rgb*scale;Y=luma(rgb);Lt=tone(Y);rgb=rgb*np.where(Y>1e-8,Lt/(Y+1e-12),0)[...,None]
 return np.clip(srgb_enc(rgb),0,1),scale

def gettag(rawpg,main,code):
 t=rawpg.tags.get(code)
 if t is None:t=main.tags.get(code)
 return t

def estimate_dual_forward(main,rawpg):
 t1=gettag(rawpg,main,50964); t2=gettag(rawpg,main,50965); ntag=gettag(rawpg,main,50728)
 if t1 is None or ntag is None: raise RuntimeError('missing ForwardMatrix/AsShotNeutral')
 fm1=mat9(t1.value).astype(np.float64); neutral=rats(ntag.value).astype(np.float64)
 if t2 is None:return fm1.astype(np.float32),None,None
 fm2=mat9(t2.value).astype(np.float64)
 cm1t=gettag(rawpg,main,50721);cm2t=gettag(rawpg,main,50722)
 if cm1t is None or cm2t is None or np.max(np.abs(fm1-fm2))<1e-10:return fm1.astype(np.float32),None,None
 cm1=mat9(cm1t.value).astype(np.float64);cm2=mat9(cm2t.value).astype(np.float64)
 T1,T2=2856.,6504.;T=5200.
 def mccamy(x,y):
  n=(x-.3320)/(.1858-y);return 449*n**3+3525*n**2+6823.3*n+5520.33
 for _ in range(20):
  w=float(np.clip(((1/T)-(1/T2))/((1/T1)-(1/T2)),0,1));CM=w*cm1+(1-w)*cm2
  XYZ=np.linalg.inv(CM)@neutral;XYZ/=XYZ[1];x=XYZ[0]/XYZ.sum();y=XYZ[1]/XYZ.sum();Tn=float(np.clip(mccamy(x,y),T1,T2))
  if abs(Tn-T)<.1:break
  T=Tn
 w=float(np.clip(((1/T)-(1/T2))/((1/T1)-(1/T2)),0,1))
 return (w*fm1+(1-w)*fm2).astype(np.float32),float(T),w

def v47j(rgb,ns):
 a=np.maximum(rgb.astype(np.float32),0);Y=luma(a);b1,b2,b5=box(Y,1),box(Y,2),box(Y,5)
 micro=Y-b1;fine=b1-b2;texture=b2-b5;q=1-smooth01((ns-.00125)/(.00180-.00125))
 A=.25+.45*q;B=.18+.26*q;C=.10+.12*q
 low=smooth01((Y-.004)/.055);high=1-smooth01((Y-.88)/.30);shadow=.32+.68*q;tonegate=high*(shadow+(1-shadow)*low)
 sp=ns*np.sqrt(np.maximum(Y,.005)/.02);conf=smooth01((np.abs(micro)/np.maximum(sp,1e-6)-.80)/1.60)
 mg=.20+.80*conf;fg=.42+.58*conf;tg=.70+.30*conf
 act=(np.abs(fine)+.50*np.abs(texture))/np.maximum(b5,.03);ag=.15+.85*smooth01((act-.012)/.043)
 mg*=ag;fg*=.50+.50*ag;tg*=.75+.25*ag
 gx=.5*(np.roll(Y,-1,1)-np.roll(Y,1,1));gy=.5*(np.roll(Y,-1,0)-np.roll(Y,1,0));gx[:,0]=Y[:,1]-Y[:,0];gx[:,-1]=Y[:,-1]-Y[:,-2];gy[0,:]=Y[1,:]-Y[0,:];gy[-1,:]=Y[-1,:]-Y[-2,:]
 grad=np.sqrt(gx*gx+gy*gy);l=np.roll(Y,1,1);r=np.roll(Y,-1,1);u=np.roll(Y,1,0);d=np.roll(Y,-1,0);l[:,0]=Y[:,0];r[:,-1]=Y[:,-1];u[0,:]=Y[0,:];d[-1,:]=Y[-1,:]
 lap=.25*np.abs(4*Y-l-r-u-d);mgra=box(grad,2);mlap=box(lap,2);ng=grad/np.maximum(b5,.03);osc=mlap/np.maximum(mgra,1e-6)
 hard=smooth01((ng-.03)/.17)*(1-smooth01((osc-.30)/.70));eg=1-hard;mg*=eg;fg*=.40+.60*eg;tg*=.75+.25*eg
 yd=Y+(A*micro*mg+B*fine*fg+C*texture*tg)*tonegate
 lo=cv2.erode(Y,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);hi=cv2.dilate(Y,np.ones((3,3),np.uint8),borderType=cv2.BORDER_REPLICATE);rng=np.maximum(hi-lo,1e-5)
 margin=(.035+.015*q)*(1-.72*hard)*rng+2e-5;v=np.clip(yd,lo-margin,hi+margin);s=np.where(Y>1e-8,np.maximum(v,0)/(Y+1e-12),1)
 return a*s[...,None],{'Y':Y,'hard':hard}

def load_source(path,kind):
 with tifffile.TiffFile(path) as tf:
  main=tf.pages[0]
  rawpg=main if len(main.shape)==2 else main.pages[0]
  raw=rawpg.asarray().astype(np.float32)
  white=float(gettag(rawpg,main,50717).value);blv=rats(gettag(rawpg,main,50714).value)
  if len(blv)==1:bl=np.repeat(blv,4).reshape(2,2)
  else:bl=blv[:4].reshape(2,2)
  black=np.empty_like(raw)
  for r in range(2):
   for c in range(2):black[r::2,c::2]=bl[r,c]
  norm=(raw-black)/np.maximum(white-black,1)
  opt=gettag(rawpg,main,51009)
  if opt is None:raise RuntimeError('missing OpcodeList2/GainMap')
  maps=parse_dng_gainmaps(opt.value,'BGGR');stage=norm.copy();gain